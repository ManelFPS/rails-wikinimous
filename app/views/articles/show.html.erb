<div class="d-flex align-items-center gap-3 mb-3">
  <h1 class="mb-0"><%=@article.title%></h1>

  <%=link_to edit_article_path(@article), class: "text-primary" do%>
    <i class="fa-solid fa-pen-to-square btn-primary"></i>
  <%end%>

  <%=link_to article_path(@article), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" }, class: "text-primary" do%>
    <i class="fa-solid fa-trash-can"></i>
  <%end%>
</div>

<hr>

<p class="fs-5"><%=@article.content%></p>
